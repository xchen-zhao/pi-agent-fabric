{
  "name": "pi-agent-fabric",
  "version": "0.1.0",
  "description": "Quota-aware local agent orchestration for Pi, Claude Code, Codex, Grok, and Kimi Code",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "fabric": "./dist/src/cli/index.js"
  },
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "doctor": "npm run build --silent && node dist/src/cli/index.js doctor"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.81.1",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  },
  "keywords": [
    "pi-package",
    "agent-orchestration",
    "multi-agent"
  ],
  "license": "UNLICENSED"
}
